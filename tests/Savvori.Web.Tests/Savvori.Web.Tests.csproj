<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Required as of Microsoft.NET.Test.Sdk 18 / xunit.v3 4.x: VSTest is no longer supported on .NET 10 SDK+.
         Run tests via `dotnet test <this project>.csproj` directly, or `dotnet exec bin/Debug/net10.0/Savvori.Web.Tests.dll`.
         See https://aka.ms/dotnet-test-mtp-error -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\*.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
  <!-- Removed old reference to Savvori.Web.csproj -->
    <ProjectReference Include="..\..\src\Savvori.WebApi\Savvori.WebApi.csproj" />
    <ProjectReference Include="..\..\src\Savvori.WebApp\Savvori.WebApp.csproj" />
  </ItemGroup>

</Project>
