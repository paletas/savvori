@model List<Savvori.WebApp.Services.ApiModels.ScrapingStatusDto>
@functions {
    private static string FormatEta(double seconds)
    {
        var t = TimeSpan.FromSeconds(seconds);
        return t.TotalHours >= 1 ? $"{(int)t.TotalHours}h {t.Minutes}m" : t.TotalMinutes >= 1 ? $"{(int)t.TotalMinutes} min" : "<1 min";
    }
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">No store chains configured. Add chains to <code>Scraping:Chains</code> in appsettings.</div>
}
else
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @foreach (var job in Model)
        {
            var statusBadge = job.LastStatus switch
            {
                null  => ("badge-ghost",   "Never run"),
                0     => ("badge-ghost",   "Pending"),
                1     => ("badge-warning", "Running"),
                2     => ("badge-success", "Completed"),
                3     => ("badge-error",   "Failed"),
                4     => ("badge-warning", "Warnings"),
                5     => ("badge-error",   "Degraded"),
                _     => ("badge-ghost",   "Unknown")
            };
            <div class="card bg-base-100 shadow border border-base-200">
                <div class="card-body py-4 px-5">
                    <div class="flex justify-between items-start">
                        <h3 class="font-bold text-base">@(job.ChainName ?? job.ChainSlug)</h3>
                        <span class="badge @statusBadge.Item1 badge-sm">@statusBadge.Item2</span>
                    </div>
                    <div class="text-xs text-base-content/60 space-y-1 mt-2">
                        <div>Last run: <span class="font-medium text-base-content">@(job.LastRunAt.HasValue ? job.LastRunAt.Value.ToString("dd/MM/yy HH:mm") : "Never")</span></div>
                        @if (job.CompletedAt.HasValue)
                        {
                            <div>Completed: <span class="font-medium text-base-content">@job.CompletedAt.Value.ToString("dd/MM/yy HH:mm")</span></div>
                        }
                        @if (job.LastStatus == 1 && job.Progress is { } pr)
                        {
                            var est = pr.TotalIsEstimate ? "*" : "";
                            <div>Products so far: <span class="font-medium text-base-content">@((pr.ProductsSeen ?? 0).ToString("N0"))@if (pr.Total.HasValue) {<text> / @pr.Total.Value.ToString("N0")@est</text>}</span></div>
                            @if (pr.Total.HasValue && pr.ProductsSeen.HasValue && pr.Total.Value > 0)
                            {
                                <progress class="progress progress-warning w-full" value="@Math.Min(pr.ProductsSeen.Value, pr.Total.Value)" max="@pr.Total.Value"></progress>
                            }
                            @if (!string.IsNullOrEmpty(pr.Key))
                            {
                                <div class="break-words">Key: <span class="font-medium text-base-content">@pr.Key</span>@if (pr.KeysTotal.HasValue) {<text> (@(pr.KeysDone ?? 0)/@pr.KeysTotal.Value)</text>}</div>
                            }
                            @if (pr.EtaSeconds.HasValue)
                            {
                                <div>ETA: <span class="font-medium text-base-content">~@FormatEta(pr.EtaSeconds.Value)@(pr.EtaIsEstimate ? "*" : "")</span></div>
                            }
                            @if (pr.TotalIsEstimate)
                            {
                                <div class="text-base-content/50" title="estimated from last healthy run">* estimated from last healthy run</div>
                            }
                            @if (pr.LastProgressAt.HasValue)
                            {
                                <div>Last progress: @((int)Math.Max(0, (DateTime.UtcNow - pr.LastProgressAt.Value).TotalSeconds))s ago</div>
                            }
                            @if (pr.Stalled)
                            {
                                <div><span class="badge badge-error badge-sm">Stalled</span> no heartbeat@(pr.LastHeartbeatAt.HasValue ? $" for {(int)Math.Max(0, (DateTime.UtcNow - pr.LastHeartbeatAt.Value).TotalSeconds)}s" : "")</div>
                            }
                        }
                        else
                        {
                            <div>Products scraped: <span class="font-medium text-base-content">@job.ProductsScraped.ToString("N0")</span></div>
                        }
                        @if (!string.IsNullOrEmpty(job.HealthReason))
                        {
                            <div class="text-error break-words" title="@job.HealthReason">Reason: @job.HealthReason</div>
                        }
                        @if (job.FailedKeys is { Length: > 0 })
                        {
                            <div class="text-error break-words">Failed: @string.Join(", ", job.FailedKeys)</div>
                        }
                        @if (job.StaleMarkingSkipped)
                        {
                            <div class="text-warning">Stale-marking skipped</div>
                        }
                        @if (job.DropRatio.HasValue)
                        {
                            <div>Count vs previous (advisory): <span class="font-medium text-base-content">@job.DropRatio.Value.ToString("P0")</span></div>
                        }
                        @if (job.WarningCount > 0)
                        {
                            <div class="text-warning">Warnings: @job.WarningCount</div>
                        }
                        @if (job.IsScheduled && job.NextFireTime.HasValue)
                        {
                            <div>Next run: <span class="font-medium text-base-content">@job.NextFireTime.Value.ToString("dd/MM/yy HH:mm") UTC</span></div>
                        }
                        else if (!job.IsScheduled)
                        {
                            <div class="text-base-content/40 italic">Not scheduled</div>
                        }
                        @if (!string.IsNullOrEmpty(job.ErrorMessage))
                        {
                            <div class="text-error truncate" title="@job.ErrorMessage">Error: @job.ErrorMessage</div>
                        }
                    </div>
                    <div class="card-actions justify-end mt-3">
                        <a asp-page="/Admin/Scraping/Detail" asp-route-slug="@job.ChainSlug"
                           class="btn btn-ghost btn-xs">Details</a>
                        <form method="post" asp-page="/Admin/Scraping/Detail" asp-route-slug="@job.ChainSlug"
                              asp-page-handler="Trigger" style="display:inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary btn-xs"
                                    onclick="return confirm('Trigger scrape for @(job.ChainName ?? job.ChainSlug)?')">
                                ▶ Trigger
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
