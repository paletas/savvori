@page
@model TaxonomyIndexModel
@using Savvori.WebApp.Pages.Admin.Taxonomy
@{
    ViewData["Title"] = "Taxonomy v2";
    Layout = "../_AdminLayout";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold">Taxonomy v2</h1>
    <p class="text-base-content/60 text-sm mt-1">
        12 aisles and 87 categories, with Bio, sem lactose, sem glúten, vegan and sem açúcar as tags. The table below is a dry run
        of what applying it would do to your current categories; nothing changes until you press Apply.
    </p>
</div>

@if (Model.Plan is not { } plan)
{
    <div class="alert alert-error">Could not load the migration plan.</div>
}
else
{
    <div class="card bg-base-100 shadow mb-6">
        <div class="card-body p-4">
            <div class="flex flex-wrap items-center gap-3">
                @if (plan.V2Active) { <span class="badge badge-success">Taxonomy v2 is active</span> }
                else { <span class="badge badge-warning">Taxonomy v1 is active</span> }
                <span class="badge badge-outline">Categorised products: @plan.ProductsWithCategory.ToString("N0")</span>
                @if (plan.ProductsAlreadyMigrated > 0) { <span class="badge badge-ghost">Already migrated: @plan.ProductsAlreadyMigrated.ToString("N0")</span> }
                @if (!plan.V2Active) { <span class="badge badge-info">Would become uncategorised (for the classifier): @plan.MovedToUncategorised.ToString("N0")</span> }
                @foreach (var t in plan.Tags) { <span class="badge badge-ghost">tag @t.Key: @t.Value.ToString("N0")</span> }
            </div>
            <div class="flex gap-2 mt-3">
                @if (!plan.V2Active)
                {
                    <form method="post" asp-page-handler="Apply"><button class="btn btn-sm btn-primary" type="submit">Apply taxonomy v2</button></form>
                }
                else
                {
                    <form method="post" asp-page-handler="Revert"><button class="btn btn-sm btn-warning" type="submit">Revert to v1</button></form>
                }
            </div>
            <p class="text-xs text-base-content/60">
                Reversible: every migrated product keeps its v1 category. A revert leaves categories you set by hand alone.
            </p>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="table table-sm bg-base-100">
            <thead><tr><th>Current (v1) category</th><th>Products</th><th>Stay / 1:1</th><th>Placed by rule</th><th>Left for classifier</th><th>Rule targets</th></tr></thead>
            <tbody>
            @foreach (var r in plan.Rows)
            {
                <tr>
                    <td>@r.LegacyName <code class="text-xs">@r.LegacySlug</code></td>
                    <td>@r.Products.ToString("N0")</td>
                    <td>@r.OneToOne.ToString("N0")</td>
                    <td>@r.ByRule.ToString("N0")</td>
                    <td>@r.LeftForClassifier.ToString("N0")</td>
                    <td class="text-xs">@string.Join(", ", r.RuleTargets.OrderByDescending(x => x.Value).Select(x => $"{x.Key}: {x.Value}"))</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
