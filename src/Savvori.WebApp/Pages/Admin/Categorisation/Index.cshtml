@page
@model CategorisationIndexModel
@using Savvori.WebApp.Pages.Admin.Categorisation
@{
    ViewData["Title"] = "Category suggestions";
    Layout = "../_AdminLayout";
}

<div class="mb-6">
    <h1 class="text-2xl font-bold">Category suggestions</h1>
    <p class="text-base-content/60 text-sm mt-1">
        Categories predicted from similar, already categorised products. Only products without a category are ever considered,
        so existing categories are never changed.
    </p>
</div>

@if (Model.Summary is { } summary)
{
    <div class="card bg-base-100 shadow mb-6">
        <div class="card-body p-4">
            <div class="flex flex-wrap items-center gap-3">
                @if (summary.DryRun)
                {
                    <span class="badge badge-warning">Dry run</span>
                    <span class="text-sm">Nothing is assigned automatically; predictions wait here (<code>Model:Categories:DryRun</code> is on).</span>
                }
                else
                {
                    <span class="badge badge-success">Applying</span>
                    <span class="text-sm">Confident predictions are assigned automatically and can be undone under "Applied".</span>
                }
                <span class="badge badge-outline">Uncategorised products: @summary.Uncategorised.ToString("N0")</span>
                @{
                    int Count(params string[] statuses) => summary.ByStatus.Where(x => statuses.Contains(x.Status)).Sum(x => x.Count);
                }
                <span class="badge badge-ghost">To review: @Count("Suggested").ToString("N0")</span>
                <span class="badge badge-ghost">Assigned: @Count("Applied").ToString("N0")</span>
                <span class="badge badge-ghost" title="Decided as not this category; never proposed again for that product">Ruled out: @Count("Rejected").ToString("N0")</span>
            </div>
            <form method="post" asp-page-handler="Run" class="mt-3">
                <input type="hidden" name="Filter" value="@Model.Filter" />
                <button type="submit" class="btn btn-sm btn-primary">Run classifier now</button>
                <span class="text-xs text-base-content/60 ml-2">Uses stored embeddings only; never waits for the model.</span>
            </form>
        </div>
    </div>
}

@if (Model.Strings.Count > 0)
{
    <div class="card bg-base-100 shadow mb-6">
        <div class="card-body p-4">
            <h2 class="font-semibold">Store categories that look uniform</h2>
            <p class="text-xs text-base-content/60">One decision applies to every uncategorised product carrying that store category.</p>
            <table class="table table-sm">
                <thead><tr><th>Store category</th><th>Products</th><th>Suggested</th><th>Agreement</th><th></th></tr></thead>
                <tbody>
                @foreach (var d in Model.Strings)
                {
                    <tr>
                        <td><code>@d.RawString</code></td>
                        <td>@d.Support</td>
                        <td>@d.Category</td>
                        <td>@d.Confidence.ToString("P0")</td>
                        <td class="flex gap-2">
                            <form method="post" asp-page-handler="AcceptString"><input type="hidden" name="id" value="@d.Id" /><input type="hidden" name="Filter" value="@Model.Filter" /><button class="btn btn-xs btn-success">Apply to all</button></form>
                            <form method="post" asp-page-handler="RejectString"><input type="hidden" name="id" value="@d.Id" /><input type="hidden" name="Filter" value="@Model.Filter" /><button class="btn btn-xs btn-error btn-outline">Decide one by one</button></form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

<div role="tablist" class="tabs tabs-bordered mb-4">
    <a role="tab" asp-page="/Admin/Categorisation/Index" asp-route-filter="suggested" class="tab @(Model.Filter == "suggested" ? "tab-active" : "")">Needs review</a>
    <a role="tab" asp-page="/Admin/Categorisation/Index" asp-route-filter="applied" class="tab @(Model.Filter == "applied" ? "tab-active" : "")">Assigned (undo)</a>
    <a role="tab" asp-page="/Admin/Categorisation/Index" asp-route-filter="bulk" class="tab @(Model.Filter == "bulk" ? "tab-active" : "")">Bulk apply</a>
</div>

@if (Model.Filter == "bulk")
{
    var running = Model.Batches.Any(b => b.Status is "Running" or "Undoing");
    if (running) { <meta http-equiv="refresh" content="5" /> }
    if (Model.BulkPreview is not { } bulk)
    {
        <div class="alert alert-error">Could not load the bulk preview.</div>
    }
    else
    {
        <div class="card bg-base-100 shadow mb-6">
            <div class="card-body p-4">
                <h2 class="font-semibold">Assign every confident prediction in one go</h2>
                <p class="text-sm text-base-content/70">
                    Takes the per-product predictions from the confidence below upwards. Products that already have a category are never touched.
                    It runs in the background as one run that you can undo in a single step. (Whole store-category proposals are decided under "Needs review".)
                </p>
                <form method="get" class="flex items-end gap-2 mt-2">
                    <input type="hidden" name="filter" value="bulk" />
                    <label class="form-control w-40"><span class="label-text text-xs">Minimum confidence</span>
                        <input name="min" type="number" step="0.01" min="0.5" max="1" value="@Model.Min.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="input input-sm input-bordered" /></label>
                    <button class="btn btn-sm">Update preview</button>
                </form>
                <div class="mt-3"><span class="badge badge-info badge-lg">@bulk.Eligible.ToString("N0") predictions would be assigned</span></div>
            </div>
        </div>

        if (bulk.Sample.Count > 0)
        {
            <div class="card bg-base-100 shadow mb-6">
                <div class="card-body p-4">
                    <h2 class="font-semibold">Spot-check a random sample first</h2>
                    <p class="text-sm text-base-content/70">Tick the products whose suggested category is <b>wrong</b>. The tally is only for you: it is not saved.</p>
                    <div id="sample-tally" class="badge badge-outline my-2">@bulk.Sample.Count of @bulk.Sample.Count look right (100%)</div>
                    <table class="table table-sm">
                        <thead><tr><th>Wrong?</th><th>Product</th><th>Store category</th><th>Suggested</th><th>Confidence</th></tr></thead>
                        <tbody>
                        @foreach (var s in bulk.Sample)
                        {
                            <tr>
                                <td><input type="checkbox" class="checkbox checkbox-sm checkbox-error sample-wrong" /></td>
                                <td>@s.ProductName <span class="text-xs text-base-content/60">@s.Brand</span></td>
                                <td>@(s.RawCategory ?? "–")</td>
                                <td><span class="badge badge-info">@s.Suggested</span></td>
                                <td>@s.Confidence.ToString("P0")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <form method="post" asp-page-handler="BulkApply" class="flex items-center gap-3 mt-3">
                        <input type="hidden" name="min" value="@Model.Min.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                        <label class="label cursor-pointer gap-2"><input type="checkbox" required class="checkbox checkbox-sm" /><span class="label-text text-sm">I checked the sample and I am happy with it</span></label>
                        <button class="btn btn-sm btn-primary" type="submit" disabled="@(bulk.Busy || running)">Assign @bulk.Eligible.ToString("N0") categories</button>
                    </form>
                </div>
            </div>
            <script>
                (function () {
                    var boxes = document.querySelectorAll('.sample-wrong');
                    var tally = document.getElementById('sample-tally');
                    function update() {
                        var total = boxes.length, wrong = document.querySelectorAll('.sample-wrong:checked').length, right = total - wrong;
                        tally.textContent = right + ' of ' + total + ' look right (' + Math.round(100 * right / total) + '%)';
                        tally.className = 'badge my-2 ' + (right / total >= 0.9 ? 'badge-success' : right / total >= 0.75 ? 'badge-warning' : 'badge-error');
                    }
                    boxes.forEach(function (b) { b.addEventListener('change', update); });
                })();
            </script>
        }

        <h2 class="font-semibold mb-2">Bulk runs</h2>
        if (Model.Batches.Count == 0)
        {
            <div class="alert alert-info">No bulk runs yet.</div>
        }
        else
        {
            <table class="table table-sm bg-base-100">
                <thead><tr><th>When</th><th>Confidence ≥</th><th>Status</th><th>Assigned</th><th>Skipped</th><th></th></tr></thead>
                <tbody>
                @foreach (var b in Model.Batches)
                {
                    <tr>
                        <td>@b.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@b.Threshold.ToString("0.00")</td>
                        <td><span class="badge @(b.Status == "Done" ? "badge-success" : b.Status == "Failed" ? "badge-error" : b.Status == "Undone" ? "badge-ghost" : "badge-warning")">@b.Status</span> @b.Error</td>
                        <td>@b.Applied.ToString("N0") of @b.Total.ToString("N0")@(b.Undone > 0 ? $" ({b.Undone:N0} undone)" : "")</td>
                        <td>@b.Blocked.ToString("N0")</td>
                        <td>
                            @if (b.Status == "Done" && b.Applied > 0)
                            {
                                <form method="post" asp-page-handler="BulkUndo"><input type="hidden" name="id" value="@b.Id" /><input type="hidden" name="min" value="@Model.Min.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" /><button class="btn btn-xs btn-warning" type="submit">Undo this run</button></form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    }
}
else if (Model.Suggestions is null)
{
    <div class="alert alert-error">Could not load suggestions.</div>
}
else if (Model.Suggestions.Items.Count == 0)
{
    <div class="alert alert-info">Nothing here.</div>
}
else
{
    <div class="overflow-x-auto">
        <table class="table table-sm bg-base-100">
            <thead><tr><th>Product</th><th>Store category</th><th>Suggested</th><th>Runner-up</th><th>Confidence</th><th></th></tr></thead>
            <tbody>
            @foreach (var s in Model.Suggestions.Items)
            {
                <tr>
                    <td>
                        <div class="flex items-center gap-2">
                            @if (!string.IsNullOrEmpty(s.ImageUrl)) { <img src="@s.ImageUrl" alt="" class="w-10 h-10 object-contain rounded bg-base-200" loading="lazy" /> }
                            <div><div class="font-medium">@s.ProductName</div><div class="text-xs text-base-content/60">@s.Brand</div></div>
                        </div>
                    </td>
                    <td>@(s.RawCategory ?? "–")</td>
                    <td><span class="badge badge-info">@s.Suggested</span> <span class="text-xs text-base-content/50">@s.Method</span></td>
                    <td>@(s.RunnerUp ?? "–")</td>
                    <td>@s.Confidence.ToString("P0") <span class="text-xs text-base-content/50">(@s.NeighbourCount neighbours)</span></td>
                    <td class="flex gap-2">
                        @if (s.Status == "Applied")
                        {
                            <form method="post" asp-page-handler="Undo"><input type="hidden" name="id" value="@s.Id" /><input type="hidden" name="Filter" value="@Model.Filter" /><input type="hidden" name="p" value="@Model.PageNumber" /><button class="btn btn-xs btn-warning">Undo</button></form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Accept"><input type="hidden" name="id" value="@s.Id" /><input type="hidden" name="Filter" value="@Model.Filter" /><input type="hidden" name="p" value="@Model.PageNumber" /><button class="btn btn-xs btn-success">Accept</button></form>
                            <form method="post" asp-page-handler="Reject"><input type="hidden" name="id" value="@s.Id" /><input type="hidden" name="Filter" value="@Model.Filter" /><input type="hidden" name="p" value="@Model.PageNumber" /><button class="btn btn-xs btn-error btn-outline">Reject</button></form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (Model.Suggestions.TotalPages > 1)
    {
        <div class="join mt-3">
            @for (var n = 1; n <= Model.Suggestions.TotalPages; n++)
            {
                <a class="join-item btn btn-sm @(n == Model.Suggestions.Page ? "btn-active" : "")" asp-page="/Admin/Categorisation/Index" asp-route-filter="@Model.Filter" asp-route-p="@n">@n</a>
            }
        </div>
    }
}
